# Firebase — keep config/secrets out of the public repo.
# Obtain from Firebase Console > Project Settings; in CI, inject as a secret.
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
.firebase/
firebase-debug.log

# Signing secrets — NEVER commit these. Keep the keystore + passwords local /
# in a secret manager. key.properties.example (the template) stays tracked.
*.jks
*.keystore
key.properties
!key.properties.example
go-service-signing-backup.zip

# Release build artifacts
*.aab
*.apk
composeApp/release/
